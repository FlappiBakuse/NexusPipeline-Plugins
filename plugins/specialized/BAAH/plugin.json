{
  "schemaVersion": 2,
  "name": "baah",
  "artifactName": "BAAH",
  "displayName": "蔚蓝档案爱丽丝助手",
  "gameName": "蔚蓝档案",
  "description": "BAAH（BlueArchiveArisHelper）专项脚本实例配置接管：按用户指定配置文件名无头运行，自动适配配置与日志，支持仅重试失败任务",
  "version": "0.2.0",
  "kind": "data-specialized",
  "minHostVersion": "0.16.8",
  "capabilities": [
    "emulator",
    "self-managed-pc-launch"
  ],
  "resolve": "data/resolve.json",
  "judgeScript": "data/judge.js",
  "localization": {
    "defaultLocale": "zh-CN",
    "locales": {
      "zh-CN": "i18n/zh-CN.json",
      "en-US": "i18n/en-US.json"
    }
  },
  "taskProtocol": {
    "version": "0.1.0",
    "discoverScript": "data/discover.js",
    "retryScript": "data/retry.js",
    "readResources": [
      {
        "id": "software-config",
        "source": "extraConfig",
        "path": "0",
        "format": "json",
        "required": false
      }
    ],
    "localization": {
      "defaultLocale": "zh-CN",
      "messages": {
        "zh-CN": "data/i18n/zh-CN.json",
        "en-US": "data/i18n/en-US.json"
      }
    },
    "configRules": [
      {
        "id": "baah.game_target",
        "required": true,
        "criticality": "advisory_or_contextual"
      },
      {
        "id": "baah.file_logging",
        "required": true,
        "criticality": "critical_when_applicable"
      }
    ],
    "environmentChecks": [
      {
        "id": "baah-pc-game-target",
        "source": {
          "kind": "mainConfig",
          "selector": [
            "TARGET_EMULATOR_PATH"
          ]
        },
        "expectedKind": "file",
        "relativeBase": "none",
        "comparison": "exact",
        "networkAccess": false,
        "followReparsePoints": false
      },
      {
        "id": "baah-adb-target",
        "source": {
          "kind": "mainConfig",
          "selector": [
            "TARGET_IP_PATH"
          ]
        },
        "expectedKind": "adb_endpoint",
        "relativeBase": "none",
        "comparison": "adb_endpoint_with_port",
        "secondarySelector": [
          "TARGET_PORT"
        ],
        "networkAccess": false,
        "followReparsePoints": false,
        "defaultValue": "127.0.0.1",
        "secondaryDefaultValue": "5555"
      }
    ]
  }
}
