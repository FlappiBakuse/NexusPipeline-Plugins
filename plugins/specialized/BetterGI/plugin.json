{
  "schemaVersion": 2,
  "name": "bettergi",
  "artifactName": "BetterGI",
  "displayName": "更好的原神",
  "gameName": "原神",
  "description": "BetterGenshinImpact 专项脚本实例配置接管（自动推导主程序、配置、日志路径与自启动参数，按用户接管指定的一条龙配置）",
  "version": "0.4.0",
  "kind": "data-specialized",
  "minHostVersion": "0.16.15",
  "resolve": "data/resolve.json",
  "judgeScript": "data/judge.js",
  "configEditor": "data/editor.js",
  "localization": {
    "defaultLocale": "zh-CN",
    "locales": {
      "zh-CN": "i18n/zh-CN.json",
      "en-US": "i18n/en-US.json"
    }
  },
  "taskProtocol": {
    "version": "0.2.0",
    "repairRules": [
      {
        "id": "game_path",
        "ruleId": "bettergi.game_target",
        "resourceId": "extra:0",
        "selector": [
          "genshinStartConfig",
          "installPath"
        ],
        "source": "user_snapshot",
        "format": "json",
        "kind": "bind_game_path",
        "fromValues": [],
        "toValue": "",
        "preconditions": {
          "snapshotKind": "any",
          "exclusiveResource": true,
          "noExtraConfig": false
        },
        "explanation": "仅修改当前用户快照的这一项；应用前备份原字节，其他账号及脚本现场保持不变。若还有修复项，请继续预览。"
      },
      {
        "id": "finish_action",
        "ruleId": "bettergi.finish_action",
        "resourceId": "config:$main",
        "selector": [
          "CompletionAction"
        ],
        "source": "user_snapshot",
        "format": "json",
        "kind": "normalize_enum",
        "fromValues": [
          "",
          "无",
          "关闭游戏",
          "关闭软件",
          "关闭游戏和软件"
        ],
        "toValue": "无",
        "preconditions": {
          "snapshotKind": "any",
          "exclusiveResource": true,
          "noExtraConfig": false
        },
        "explanation": "仅修改当前用户快照的这一项；应用前备份原字节，其他账号及脚本现场保持不变。若还有修复项，请继续预览。"
      }
    ],
    "discoverScript": "data/discover.js",
    "retryScript": "data/retry.js",
    "readResources": [
      {
        "id": "extra-user-config",
        "source": "extraConfig",
        "path": "0",
        "format": "json",
        "required": false
      }
    ],
    "localization": {
      "defaultLocale": "zh-CN",
      "messages": {
        "zh-CN": "data/i18n/zh-CN.json",
        "en-US": "data/i18n/en-US.json"
      }
    },
    "configRules": [
      {
        "id": "bettergi.game_target",
        "required": true,
        "criticality": "advisory_or_contextual"
      },
      {
        "id": "bettergi.finish_action",
        "required": true,
        "criticality": "critical_when_applicable"
      }
    ],
    "environmentChecks": [
      {
        "id": "bettergi-game-target",
        "source": {
          "kind": "resource",
          "resourceId": "extra-user-config",
          "selector": [
            "genshinStartConfig",
            "installPath"
          ]
        },
        "expectedKind": "file_or_directory",
        "relativeBase": "none",
        "comparison": "path_or_executable_parent",
        "networkAccess": false,
        "followReparsePoints": false
      }
    ]
  }
}
