{
  "extensionId": "march7th",
  "artifactName": "March7thAssistant",
  "displayName": "三月七小助手",
  "packageVersion": "0.5.0",
  "kind": "data-specialized",
  "minHostVersion": "0.18.0",
  "capabilities": [
    "task.adapt",
    "configuration.edit"
  ],
  "permissions": {
    "fileAccess": [
      "selected-script-root"
    ]
  },
  "specialized": {
    "adapterEntry": "adapter/main.js",
    "sourceDiscovery": true,
    "instancePolicy": {
      "selfManagedPcLaunch": false,
      "supportsAndroid": false,
      "requiresConfigurationSync": true
    }
  },
  "gameName": "崩坏：星穹铁道",
  "summary": "March7th Assistant 专项脚本实例配置接管（Launcher 编辑配置 / Assistant 运行脚本，自动推导主程序、启动目标、配置与日志路径）",
  "author": "FlappiBakuse",
  "tags": [
    "崩坏：星穹铁道",
    "专项插件",
    "配置接管",
    "Honkai: Star Rail",
    "Specialized plugin",
    "March7thAssistant"
  ],
  "localization": {
    "defaultLocale": "zh-CN",
    "locales": {
      "zh-CN": "i18n/zh-CN.json",
      "en-US": "i18n/en-US.json"
    }
  },
  "icon": "assets/icon.ico"
}
