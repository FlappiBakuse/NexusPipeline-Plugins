    "repairRules": [
      {
        "id": "game_path",
        "ruleId": "okscript.game_target",
        "resourceId": "config:devices.json",
        "selector": [
          "pc_full_path"
        ],
        "source": "user_snapshot",
        "format": "json",
        "kind": "bind_game_path",
        "fromValues": [],
        "toValue": "",
