{
  "schemaVersion": 2,
  "name": "oknte",
  "artifactName": "OkNTE",
  "displayName": "ok-nte 日常",
  "gameName": "异环",
  "description": "单账号日常任务计划、配置隔离与任务结果判定",
  "version": "0.2.1",
  "kind": "data-specialized",
  "minHostVersion": "0.17.2",
  "resolve": "data/resolve.json",
  "judgeScript": "data/judge.js",
  "capabilities": [
    "no-fresh-config",
    "self-managed-pc-launch"
  ],
  "localization": {
    "defaultLocale": "zh-CN",
    "locales": {
      "zh-CN": "i18n/zh-CN.json",
      "en-US": "i18n/en-US.json"
    }
  },
  "taskProtocol": {
    "version": "0.2.0",
    "discoverScript": "data/discover.js",
    "retryScript": "data/retry.js",
    "readResources": [
      {
        "id": "runtime-app",
        "source": "root",
        "path": "data/apps/ok-nte/app.json",
        "format": "json",
        "required": false,
        "operationalFields": {
          "running": "boolean",
          "last_start": "timestamp"
        }
      },
      {
        "id": "runtime-head",
        "source": "root",
        "path": "data/apps/ok-nte/repo/.git/HEAD",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-tag",
        "source": "root",
        "path": "data/apps/ok-nte/repo/.git/refs/tags/v1.3.19",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-origin",
        "source": "root",
        "path": "data/apps/ok-nte/repo/.git/config",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-0",
        "source": "root",
        "path": "data/apps/ok-nte/working/main.py",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-1",
        "source": "root",
        "path": "data/apps/ok-nte/working/ok/feature/Feature.py",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-2",
        "source": "root",
        "path": "data/apps/ok-nte/working/ok/task/TaskExecutor.py",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-3",
        "source": "root",
        "path": "data/apps/ok-nte/working/ok/ui/qt/StartController.py",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-4",
        "source": "root",
        "path": "data/apps/ok-nte/working/pyappify.yml",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-5",
        "source": "root",
        "path": "data/apps/ok-nte/working/requirements.txt",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-6",
        "source": "root",
        "path": "data/apps/ok-nte/working/src/config.py",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-7",
        "source": "root",
        "path": "data/apps/ok-nte/working/src/tasks/AnomalyHunter.py",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-8",
        "source": "root",
        "path": "data/apps/ok-nte/working/src/tasks/AnomalyTask.py",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-9",
        "source": "root",
        "path": "data/apps/ok-nte/working/src/tasks/LauncherTask.py",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-10",
        "source": "root",
        "path": "data/apps/ok-nte/working/src/tasks/daily/CinemaDateTask.py",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-11",
        "source": "root",
        "path": "data/apps/ok-nte/working/src/tasks/daily/CoffeeTask.py",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-12",
        "source": "root",
        "path": "data/apps/ok-nte/working/src/tasks/daily/DailyClaimTask.py",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-13",
        "source": "root",
        "path": "data/apps/ok-nte/working/src/tasks/daily/DailyRoutineTask.py",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-14",
        "source": "root",
        "path": "data/apps/ok-nte/working/src/tasks/daily/FountainTask.py",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-15",
        "source": "root",
        "path": "data/apps/ok-nte/working/src/tasks/daily/FurnitureTask.py",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-code-16",
        "source": "root",
        "path": "data/apps/ok-nte/working/src/tasks/daily/GiftTask.py",
        "format": "text",
        "required": false
      }
    ],
    "localization": {
      "defaultLocale": "zh-CN",
      "messages": {
        "zh-CN": "data/i18n/zh-CN.json",
        "en-US": "data/i18n/en-US.json"
      }
    },
    "configRules": [
      {
        "id": "okscript.distribution",
        "required": true,
        "criticality": "critical_when_applicable"
      },
      {
        "id": "okscript.single_daily",
        "required": true,
        "criticality": "critical_when_applicable"
      },
      {
        "id": "oknte.routine_schema",
        "required": true,
        "criticality": "critical_when_applicable"
      },
      {
        "id": "okscript.game_target",
        "required": true,
        "criticality": "advisory_or_contextual"
      }
    ],
    "environmentChecks": [
      {
        "id": "okscript-game-target",
        "source": {
          "kind": "config",
          "resourceId": "config:devices.json",
          "selector": [
            "pc_full_path"
          ]
        },
        "expectedKind": "file",
        "relativeBase": "none",
        "networkAccess": false,
        "followReparsePoints": false
      }
    ],
    "repairRules": [
      {
        "id": "game_path",
        "ruleId": "okscript.game_target",
        "resourceId": "config:devices.json",
        "selector": [
          "pc_full_path"
        ],
        "source": "user_snapshot",
        "format": "json",
        "kind": "bind_game_path",
        "fromValues": [],
        "toValue": "",
        "preconditions": {
          "snapshotKind": "any",
          "exclusiveResource": true,
          "noExtraConfig": false
        },
        "explanation": "仅修改当前用户快照的这一项；应用前备份原字节，其他账号及脚本现场保持不变。若还有修复项，请继续预览。"
      }
    ]
  },
  "configEditor": "data/editor.js",
  "scriptTypeIcon": {
    "url": "https://raw.githubusercontent.com/BnanZ0/ok-nte/b629f536f8d8b3c1b82d397033434838a0c3e922/icons/icon.ico",
    "sha256": "c5f2393cd14fb3ff1b38a9f5d15d5013c7bed604d9656cdf111e33c5b97abcf8",
