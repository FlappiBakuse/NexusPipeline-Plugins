{
  "schemaVersion": 2,
  "name": "oknte",
  "artifactName": "OkNTE",
  "displayName": "ok-nte 日常",
  "gameName": "异环",
  "description": "单账号日常任务计划、配置隔离与任务结果判定",
  "version": "0.1.0",
  "kind": "data-specialized",
  "minHostVersion": "0.16.8",
  "resolve": "data/resolve.json",
  "judgeScript": "data/judge.js",
  "capabilities": [
    "no-fresh-config"
  ],
  "localization": {
    "defaultLocale": "zh-CN",
    "locales": {
      "zh-CN": "i18n/zh-CN.json",
      "en-US": "i18n/en-US.json"
    }
  },
  "taskProtocol": {
    "version": "1.2",
    "discoverScript": "data/discover.js",
    "retryScript": "data/retry.js",
    "readResources": [
      {
        "id": "runtime-app",
        "source": "root",
        "path": "data/apps/ok-nte/app.json",
        "format": "json",
        "required": false
      },
      {
        "id": "runtime-head",
        "source": "root",
        "path": "data/apps/ok-nte/repo/.git/HEAD",
        "format": "text",
        "required": false
      },
      {
        "id": "runtime-tag",
        "source": "root",
        "path": "data/apps/ok-nte/repo/.git/refs/tags/v1.3.19",
        "format": "text",
        "required": false
      }
    ],
    "localization": {
      "defaultLocale": "zh-CN",
      "messages": {
        "zh-CN": "data/i18n/zh-CN.json",
        "en-US": "data/i18n/en-US.json"
      }
    },
      "configRules": [
        { "id": "okscript.distribution", "required": true, "criticality": "critical_when_applicable" },
        { "id": "okscript.single_daily", "required": true, "criticality": "critical_when_applicable" },
        { "id": "oknte.routine_schema", "required": true, "criticality": "critical_when_applicable" }
      ],
      "environmentChecks": []
    }
  }
