{
  "extensionId": "baah",
  "artifactName": "BAAH",
  "displayName": "蔚蓝档案爱丽丝助手",
  "packageVersion": "0.5.0",
  "kind": "data-specialized",
  "minHostVersion": "0.18.0",
  "capabilities": [
    "task.adapt",
    "configuration.edit",
    "target.android"
  ],
  "permissions": {
    "fileAccess": [
      "selected-script-root"
    ]
  },
  "specialized": {
    "adapterEntry": "adapter/main.js",
    "sourceDiscovery": true,
    "instancePolicy": {
      "selfManagedPcLaunch": true,
      "supportsAndroid": true,
      "requiresConfigurationSync": true
    }
  },
  "gameName": "蔚蓝档案",
  "summary": "BAAH（BlueArchiveArisHelper）专项脚本实例配置接管：按用户指定配置文件名无头运行，自动适配配置与日志，支持仅重试失败任务",
  "author": "FlappiBakuse",
  "tags": [
    "蔚蓝档案",
    "Blue Archive",
    "专项插件",
    "模拟器",
    "BAAH",
    "Specialized plugin",
    "Emulator"
  ],
  "localization": {
    "defaultLocale": "zh-CN",
    "locales": {
      "zh-CN": "i18n/zh-CN.json",
      "en-US": "i18n/en-US.json"
    }
  },
  "icon": "assets/icon.ico"
}
