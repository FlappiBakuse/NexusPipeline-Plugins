{
  "schemaVersion": 2,
  "name": "march7th",
  "artifactName": "March7thAssistant",
  "displayName": "三月七小助手",
  "gameName": "崩坏：星穹铁道",
  "description": "March7th Assistant 专项脚本实例配置接管（Launcher 编辑配置 / Assistant 运行脚本，自动推导主程序、启动目标、配置与日志路径）",
  "version": "0.4.0",
  "kind": "data-specialized",
  "minHostVersion": "0.16.15",
  "localization": {
    "defaultLocale": "zh-CN",
    "locales": {
      "zh-CN": "i18n/zh-CN.json",
      "en-US": "i18n/en-US.json"
    }
  },
  "resolve": "data/resolve.json",
  "judgeScript": "data/judge.js",
  "taskProtocol": {
    "version": "0.2.0",
    "discoverScript": "data/discover.js",
    "retryScript": "data/retry.js",
    "readResources": [],
    "localization": {
      "defaultLocale": "zh-CN",
      "messages": {
        "zh-CN": "data/i18n/zh-CN.json",
        "en-US": "data/i18n/en-US.json"
      }
    },
    "configRules": [
      {
        "id": "march7th.game_target",
        "required": true,
        "criticality": "advisory_or_contextual"
      },
      {
        "id": "march7th.finish_action",
        "required": true,
        "criticality": "critical_when_applicable"
      },
      {
        "id": "march7th.process_exit",
        "required": true,
        "criticality": "advisory_or_contextual"
      }
    ],
    "environmentChecks": [
      {
        "id": "march7th-game-target",
        "source": {
          "kind": "config",
          "resourceId": "config:config.yaml",
          "selector": [
            "game_path"
          ]
        },
        "expectedKind": "file",
        "relativeBase": "none",
        "networkAccess": false,
        "followReparsePoints": false
      }
    ],
    "repairRules": [
      {
        "id": "game_path",
        "ruleId": "march7th.game_target",
        "resourceId": "config:config.yaml",
        "selector": [
          "game_path"
        ],
        "source": "user_snapshot",
        "format": "yaml",
        "kind": "bind_game_path",
        "fromValues": [],
        "toValue": "",
        "preconditions": {
          "snapshotKind": "any",
          "exclusiveResource": true,
          "noExtraConfig": false
        },
        "explanation": "仅修改当前用户快照的这一项；应用前备份原字节，其他账号及脚本现场保持不变。若还有修复项，请继续预览。",
        "skipWhen": {
          "selector": [
            "cloud_game_enable"
          ],
          "equals": true
        }
      },
      {
        "id": "queue_finish_action",
        "ruleId": "march7th.finish_action",
        "resourceId": "config:config.yaml",
        "selector": [
          "after_finish"
        ],
        "source": "user_snapshot",
        "format": "yaml",
        "kind": "normalize_enum",
        "fromValues": [
          "None",
          "Exit",
          "无",
          "退出程序",
          "关闭游戏",
          "关闭软件"
        ],
        "toValue": "None",
        "preconditions": {
          "snapshotKind": "any",
          "exclusiveResource": true,
          "noExtraConfig": false
        },
        "explanation": "仅修改当前用户快照的这一项；应用前备份原字节，其他账号及脚本现场保持不变。若还有修复项，请继续预览。"
      }
    ]
  },
  "configEditor": "data/editor.js"
}
