<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.3</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(NexusHostRoot)\src\NexusPipeline.Plugin.Abstractions\NexusPipeline.Plugin.Abstractions.csproj" />
    <PackageReference Include="Maa.Framework.Binding.Native" Version="5.10.0" />
    <Compile Include="..\core\**\*.cs" LinkBase="Core" />
    <EmbeddedResource Include="..\compatibility\native-recipes.json" LogicalName="MaaFrameworkDriver.NativeRecipes.json" />
    <EmbeddedResource Include="..\compatibility\python-recipes.json" LogicalName="MaaFrameworkDriver.PythonRecipes.json" />
    <Compile Include="..\src\WindowDiscovery.cs" Link="Core\WindowDiscovery.cs" />
  </ItemGroup>
</Project>
