{
  "id": "okww",
  "implementation": "okww",
  "protocolVersion": "0.2.0",
  "configRules": [
    {
      "id": "okscript.distribution",
      "required": true,
      "criticality": "critical_when_applicable",
      "kind": "runtime_distribution",
      "reasonKey": "diagnostic.runtime_unqualified",
      "fallback": "官方发行版本或更新状态未就绪，已阻止自动运行。",
      "location": {
        "source": "resource",
        "resourceId": "runtime-app",
        "selector": [
          "current_profile"
        ]
      }
    },
    {
      "id": "okscript.single_daily",
      "required": true,
      "criticality": "critical_when_applicable",
      "kind": "single_daily",
      "allowedTaskKeys": [
        "daily",
        "nightmare",
        "stamina",
        "daily_reward",
        "mail",
        "battle_pass",
        "garden",
        "merge",
        "farm_4c"
      ],
      "reasonKey": "diagnostic.okscript.single_daily",
      "fallback": "当前计划不是可确认的单一日常执行计划。",
      "location": {
        "source": "context",
        "field": "effectiveLaunch.entryId"
      }
    },
    {
      "id": "okww.finite_additions",
      "required": true,
      "criticality": "critical_when_applicable",
      "kind": "finite_additions",
      "resourceId": "config:FarmEchoTask.json",
      "taskKey": "farm_4c",
      "reasonKey": "diagnostic.okww.finite_additions",
      "fallback": "4C 附加任务的传送模式或有限次数无法确认。",
      "location": {
        "source": "config",
        "resourceId": "config:FarmEchoTask.json",
        "selector": [
          "Teleport to Boss"
        ]
      }
    },
    {
      "id": "okscript.game_target",
      "required": true,
      "criticality": "advisory_or_contextual",
      "kind": "target_compare",
      "inspectionId": "okscript-game-target",
      "fallback": "脚本中的游戏路径与项目绑定目标不一致。"
    }
  ],
  "configDependencies": [
    {
      "task": "farm_4c",
      "file": "FarmEchoTask.json",
      "keys": [
        "Teleport to Boss",
        "Boss Level",
        "Boss",
        "Repeat Farm Count",
        "Combat Wait Time",
        "Which Weekly Boss to Teleport",
        "Which Boss Challenge to Teleport"
      ]
    },
    {
      "task": "nightmare",
      "file": "NightmareNestTask.json",
      "keys": [
        "Which to Farm"
      ]
    }
  ],
  "taskTextKeys": {
    "nightmare": "task.nightmare",
    "daily_reward": "task.daily_reward",
    "mail": "task.mail",
    "battle_pass": "task.battle_pass",
    "garden": "task.garden",
    "merge": "task.merge",
    "farm_4c": "task.farm_4c"
  },
  "reasonTexts": {
    "okww.step.started": "日常步骤已开始",
    "okww.garden.already_done": "每周花园已经完成",
    "okww.nightmare.started": "梦魇任务已开始",
    "okww.step.caught_failure": "该步骤捕获异常后继续；后续完成不覆盖此失败",
    "okww.battle_pass.not_found": "未找到通行证入口，奖励领取未确认",
    "okww.daily.completed": "日常任务完成",
    "okww.daily.failed": "日常任务失败",
    "okww.step.completed": "日常子流程结束"
  },
  "staminaTextKeys": {
    "Tacet Suppression": "task.stamina_tacet",
    "Forgery Challenge": "task.stamina_forgery",
    "Simulation Challenge": "task.stamina_simulation"
  },
  "runtimeOfficialRepository": "ok-oldking/ok-wuthering-waves",
  "runtimeStructuralContracts": [
    {
      "id": "runtime-code-8",
      "patterns": [
        "^class DailyTask\\(",
        "^    def run\\(self\\):",
        "self\\.claim_daily\\(\\)",
        "self\\.claim_mail\\(\\)",
        "self\\.log_info\\('Daily Task Completed'"
      ]
    },
    {
      "id": "runtime-code-1",
      "patterns": [
        "OK\\(config\\)",
        "\\.start\\(\\)"
      ]
    },
    {
      "id": "runtime-code-3",
      "patterns": [
        "^class TaskExecutor\\b",
        "^    def ",
        "TaskDisabledException"
      ]
    }
  ],
  "dailyPolicy": {
    "completionPolicy": "authoritative",
    "workflowRole": "daily",
    "observationContract": {
      "ruleSetId": "okww.daily.v1",
      "sources": [
        "file"
      ],
      "rules": [
        {
          "id": "okww.step.started",
          "kind": "scope_started"
        },
        {
          "id": "okww.nightmare.started",
          "kind": "scope_started"
        },
        {
          "id": "okww.garden.already_done",
          "kind": "normal_skip"
        },
        {
          "id": "okww.daily.completed",
          "kind": "business_succeeded"
        },
        {
          "id": "okww.daily.failed",
          "kind": "business_failed"
        },
        {
          "id": "okww.step.caught_failure",
          "kind": "business_failed"
        },
        {
          "id": "okww.battle_pass.not_found",
          "kind": "business_failed"
        }
      ]
    },
    "retryPolicy": {
      "mode": "selective_config",
      "resourceConsumption": true,
      "limitRefs": []
    }
  },
  "runtimeOfficialOriginsByChannel": {
    "Global": [
      "https://github.com/ok-oldking/ok-ww-update.git"
    ],
    "China": [
      "https://cnb.cool/ok-oldking/ok-ww-update2.git"
    ]
  },
  "runtimeName": "ok-ww"
}
