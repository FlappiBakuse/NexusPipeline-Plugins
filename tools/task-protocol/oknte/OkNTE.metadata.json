{
  "id": "oknte",
  "implementation": "oknte",
  "protocolVersion": "0.2.0",
  "configRules": [
    {
      "id": "okscript.distribution",
      "required": true,
      "criticality": "critical_when_applicable",
      "kind": "runtime_distribution",
      "reasonKey": "diagnostic.runtime_unqualified",
      "fallback": "官方发行版本或更新状态未就绪，已阻止自动运行。",
      "location": {
        "source": "resource",
        "resourceId": "runtime-app",
        "selector": [
          "current_profile"
        ]
      }
    },
    {
      "id": "okscript.single_daily",
      "required": true,
      "criticality": "critical_when_applicable",
      "kind": "single_daily",
      "allowedTaskKeys": [
        "daily_anomaly",
        "daily_anomaly_hunter",
        "coffee",
        "daily_claim",
        "cinema_date",
        "fountain",
        "furniture",
        "gift"
      ],
      "reasonKey": "diagnostic.okscript.single_daily",
      "fallback": "当前计划不是可确认的单一日常执行计划。",
      "location": {
        "source": "context",
        "field": "effectiveLaunch.entryId"
      }
    },
    {
      "id": "oknte.routine_schema",
      "required": true,
      "criticality": "critical_when_applicable",
      "kind": "routine_schema",
      "resourceId": "config:DailyRoutineTask.json",
      "reasonKey": "diagnostic.oknte.routine_schema",
      "fallback": "DailyRoutineTask 的日常选择结构无法确认。",
      "location": {
        "source": "config",
        "resourceId": "config:DailyRoutineTask.json",
        "selector": [
          "Routine Items"
        ]
      }
    },
    {
      "id": "okscript.game_target",
      "required": true,
      "criticality": "advisory_or_contextual",
      "kind": "target_compare",
      "inspectionId": "okscript-game-target",
      "fallback": "脚本中的游戏路径与项目绑定目标不一致。"
    }
  ],
  "entries": [
    {
      "id": "daily_anomaly",
      "enabledByDefault": true,
      "exclusiveGroup": "daily_anomaly",
      "name": "异象界域"
    },
    {
      "id": "daily_anomaly_hunter",
      "enabledByDefault": false,
      "exclusiveGroup": "daily_anomaly",
      "name": "异象追猎"
    },
    {
      "id": "coffee",
      "enabledByDefault": false,
      "exclusiveGroup": null,
      "name": "一咖舍"
    },
    {
      "id": "daily_claim",
      "enabledByDefault": true,
      "exclusiveGroup": null,
      "name": "日常领取"
    },
    {
      "id": "cinema_date",
      "enabledByDefault": false,
      "exclusiveGroup": null,
      "name": "影院约会"
    },
    {
      "id": "fountain",
      "enabledByDefault": false,
      "exclusiveGroup": null,
      "name": "喷泉签到"
    },
    {
      "id": "furniture",
      "enabledByDefault": false,
      "exclusiveGroup": null,
      "name": "异象家具"
    },
    {
      "id": "gift",
      "enabledByDefault": false,
      "exclusiveGroup": null,
      "name": "羁遇赠礼"
    }
  ],
  "taskTextKeys": {
    "daily_anomaly": "task.daily_anomaly",
    "daily_anomaly_hunter": "task.daily_anomaly_hunter",
    "coffee": "task.coffee",
    "daily_claim": "task.daily_claim",
    "cinema_date": "task.cinema_date",
    "fountain": "task.fountain",
    "furniture": "task.furniture",
    "gift": "task.gift"
  },
  "reasonTexts": {
    "oknte.item.started": "日常子任务已开始",
    "oknte.item.failed": "日常子任务报告失败",
    "oknte.item.completed": "日常子任务报告完成",
    "oknte.item.language_unsupported": "当前语言不支持此任务",
    "oknte.item.unhandled_exception": "当前任务因未处理异常中断",
    "oknte.routine.aborted_before_item": "日常流程中断，此任务尚未执行"
  },
  "runtimeOfficialRepository": "BnanZ0/ok-nte",
  "runtimeOfficialOriginsByChannel": {
    "China": [
      "https://cnb.cool/BnanZ0/ok-nte-update.git"
    ],
    "Global": [
      "https://github.com/BnanZ0/ok-nte-update.git"
    ]
  },
  "runtimeStructuralContracts": [
    {
      "id": "runtime-code-13",
      "patterns": [
        "^class DailyRoutineTask\\(",
        "^    def normalize_items\\(",
        "^    def _execute_routine_item\\(",
        "self\\.log_info\\(f\"任务完成:",
        "self\\.log_info\\(f\"任务失败:"
      ]
    },
    {
      "id": "runtime-code-0",
      "patterns": [
        "OK\\(config\\)",
        "\\.start\\(\\)"
      ]
    },
    {
      "id": "runtime-code-2",
      "patterns": [
        "^class TaskExecutor\\b",
        "^    def ",
        "TaskDisabledException"
      ]
    }
  ],
  "dailyPolicy": {
    "completionPolicy": "authoritative",
    "workflowRole": "daily",
    "observationContract": {
      "ruleSetId": "oknte.daily.v1",
      "sources": [
        "file"
      ],
      "rules": [
        {
          "id": "oknte.item.started",
          "kind": "scope_started"
        },
        {
          "id": "oknte.item.completed",
          "kind": "business_succeeded"
        },
        {
          "id": "oknte.item.failed",
          "kind": "business_failed"
        },
        {
          "id": "oknte.item.unhandled_exception",
          "kind": "business_failed"
        },
        {
          "id": "oknte.item.language_unsupported",
          "kind": "normal_skip"
        },
        {
          "id": "oknte.routine.aborted_before_item",
          "kind": "not_executed"
        }
      ]
    },
    "retryPolicy": {
      "mode": "selective_config",
      "resourceConsumption": true,
      "limitRefs": []
    }
  },
  "runtimeName": "ok-nte"
}
