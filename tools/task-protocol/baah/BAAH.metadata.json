  "protocolVersion": "0.1.0",
  "configRules": [
    {
      "id": "baah.game_target",
      "required": true,
      "criticality": "advisory_or_contextual",
      "kind": "target_compare",
      "inspectionIdByMode": {
        "pc": "baah-pc-game-target",
        "emulator": "baah-adb-target",
        "unknown": "baah-pc-game-target"
      },
      "reasonKey": "diagnostic.config.path_mismatch",
      "fallback": "绑定的游戏目标与配置中的目标不一致。",
      "location": {
        "source": "context",
        "field": "gameTarget"
      },
      "unverifiedWhen": {
        "mode": "emulator",
        "resourceId": "main",
        "selector": [
          "ADB_DIRECT_USE_SERIAL_NUMBER"
        ],
        "equals": true,
        "reasonKey": "diagnostic.baah.adb_serial_unverified",
        "fallback": "当前配置直接使用 ADB 序列号，无法与绑定的网络端点确认一致。",
        "requireBoolean": true
      }
    },
    {
      "id": "baah.file_logging",
      "required": true,
      "criticality": "critical_when_applicable",
      "kind": "file_logging",
      "resourceId": "software-config",
      "reasonKey": "diagnostic.baah.file_logging",
      "fallback": "未确认可读取的 BAAH 日志来源。",
      "location": {
        "source": "resource",
        "resourceId": "software-config",
        "selector": [
          "SAVE_LOG_TO_FILE"
        ]
      }
    }
  ],
