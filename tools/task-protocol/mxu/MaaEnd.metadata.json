  "protocolVersion": "0.2.0",
  "dailyPolicy": {
    "completionPolicy": "authoritative",
    "workflowRole": "daily",
    "observationContract": {
      "ruleSetId": "maaend.mxu.daily.v1",
      "sources": [
        "stdout"
      ],
      "rules": [
        {
          "id": "mxu.task.running",
          "kind": "scope_started"
        },
        {
          "id": "mxu.task.succeeded",
          "kind": "business_succeeded"
        },
        {
          "id": "mxu.task.failed",
          "kind": "business_failed"
        }
      ]
    },
    "retryPolicy": {
      "mode": "selective_config",
      "resourceConsumption": true,
      "limitRefs": []
    }
  },
  "configRules": [
    {
      "id": "mxu.launch_owner",
      "required": true,
      "criticality": "critical_when_applicable",
      "kind": "mxu_launch_owner",
      "resourceId": "config:mxu-MaaEnd.json",
      "fallback": "请将首项前置程序设置为游戏启动器并关闭等待退出，或在项目游戏联动中启用启动游戏；普通自定义程序任务在连接窗口后执行。",
      "location": {
        "source": "config",
        "resourceId": "config:mxu-MaaEnd.json",
        "selector": [
          "settings",
          "autoStartInstanceId"
        ]
      },
      "reasonKey": "diagnostic.mxu.launch_owner"
    },
    {
      "id": "mxu.autostart_target",
      "required": true,
      "criticality": "critical_when_applicable",
      "kind": "autostart",
      "resourceId": "config:mxu-MaaEnd.json",
      "missingReasonKey": "diagnostic.mxu.autostart_missing",
      "invalidReasonKey": "diagnostic.mxu.autostart_invalid",
      "fallback": "当前绑定配置没有唯一有效的自动执行实例。",
      "location": {
        "source": "config",
        "resourceId": "config:mxu-MaaEnd.json",
        "selector": [
          "settings",
          "autoStartInstanceId"
        ]
      }
    },
    {
      "id": "mxu.controller_resource",
      "required": true,
      "criticality": "advisory_or_contextual",
      "kind": "controller_resource",
      "resourceId": "config:mxu-MaaEnd.json",
      "fallback": "自动执行实例的控制器或资源选择无法确认。",
      "location": {
        "source": "config",
        "resourceId": "config:mxu-MaaEnd.json",
        "selector": [
          "settings",
          "autoStartInstanceId"
        ]
      }
    },
    {
      "id": "mxu.finish_action",
      "required": true,
      "criticality": "critical_when_applicable",
      "kind": "mxu_finish_action",
      "resourceId": "config:mxu-MaaEnd.json",
      "taskName": "__MXU_POWER__",
      "optionId": "__MXU_POWER_OPTION__",
      "reasonKey": "diagnostic.mxu.finish_action",
      "fallback": "MXU 完成后的系统动作可能影响队列后续工作。",
      "location": {
        "source": "config",
        "resourceId": "config:mxu-MaaEnd.json",
        "selector": [
          "settings",
          "autoStartInstanceId"
        ]
      },
      "defaultAction": "shutdown"
    }
  ],
