{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "taskProtocol 0.2.0 repairRules",
  "description": "Structural schema; Host and repository validation additionally enforce rule references, safe resource paths and kind-specific selectors. Protocol 0.1.1 retains its narrower validator.",
  "type": "array",
  "maxItems": 8,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "ruleId",
      "resourceId",
      "selector",
      "source",
      "format",
      "kind",
      "fromValues",
      "toValue",
      "preconditions",
      "explanation"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
      },
      "ruleId": {
        "type": "string",
        "minLength": 1
      },
      "resourceId": {
        "type": "string",
        "pattern": "^(config:\\$main|extra:0|config:[A-Za-z0-9_.{}/-]+)$"
      },
      "selector": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "source": {
        "const": "user_snapshot"
      },
      "format": {
        "enum": [
          "json",
          "yaml"
        ]
      },
      "kind": {
        "enum": [
          "replace_enum",
          "normalize_enum",
          "bind_game_path",
          "mxu_tasks",
          "mxu_preactions",
          "mfa_tasks",
          "enable_boolean"
        ]
      },
      "fromValues": {
        "type": "array",
        "maxItems": 32,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "maxLength": 64
        }
      },
      "toValue": {
        "type": "string",
        "maxLength": 512
      },
      "preconditions": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshotKind",
          "exclusiveResource",
          "noExtraConfig"
        ],
        "properties": {
          "snapshotKind": {
            "enum": [
              "file",
              "any"
            ]
          },
          "exclusiveResource": {
            "const": true
          },
          "noExtraConfig": {
            "type": "boolean"
          }
        }
      },
      "explanation": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "skipWhen": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selector",
          "equals"
        ],
        "properties": {
          "selector": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string"
            }
          },
          "equals": {
            "type": "boolean"
          }
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "kind": {
              "const": "mxu_tasks"
            }
          }
        },
        "then": {
          "properties": {
            "format": {
              "const": "json"
            },
            "selector": {
              "const": [
                "instances"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "mfa_tasks"
            }
          }
        },
        "then": {
          "properties": {
            "format": {
              "const": "json"
            },
            "selector": {
              "const": [
                "TaskItems"
              ]
            }
          }
        }
      }
    ]
  }
}
