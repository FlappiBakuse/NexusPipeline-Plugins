<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NativeProbe.cs" />
    <Compile Include="$(HostSourceRoot)/src/platform/Extensions/BoundedTaskScript.cs" Link="Host/BoundedTaskScript.cs" />
    <Reference Include="Jint"><HintPath>$(JintAssemblyPath)</HintPath></Reference>
    <Reference Include="Acornima"><HintPath>$(AcornimaAssemblyPath)</HintPath></Reference>
  </ItemGroup>
</Project>
